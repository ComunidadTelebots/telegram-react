# ============================================================
# Telegram React - Environment Configuration
# ============================================================
# Copy this file to .env.development and .env.production
# and fill in the required values.

# REQUIRED: Telegram API Credentials
# Get your API ID and Hash from: https://my.telegram.org/apps
REACT_APP_TELEGRAM_API_ID=YOUR_API_ID_HERE
REACT_APP_TELEGRAM_API_HASH=YOUR_API_HASH_HERE

# Optional: Build Configuration
# REACT_APP_DEBUG=false
# REACT_APP_ENABLE_OFFLINE_MODE=true

# Node Configuration
# NODE_ENV=development
NODE_OPTIONS=--openssl-legacy-provider

# Build
GENERATE_SOURCEMAP=true
